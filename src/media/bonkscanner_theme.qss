}
QTabWidget#CompareRunsTabs QTabBar::tab:selected {
    background-color: #2F6FB0;
    color: #FFFFFF;
}

/* ================================================= диалоги и предупреждения ==
   Всё в этом разделе жило в legacy_stylesheet — запасном листе, который
   `build_qt_app_stylesheet` берёт ТОЛЬКО когда этот файл не прочитался
   (`base_stylesheet = redesign_stylesheet or legacy_stylesheet`). То есть в
   рабочей сборке эти девять правил не применялись никогда: карточка
   предупреждения теряла янтарный фон, заголовок — цвет и размер, четыре
   кнопки поддержки — свои фирменные цвета. Перенесены сюда, в палитру
   редизайна, а не скопированы старыми значениями. */

/* Карточка «прочти это» (Auto-Reroll, напоминание про запись OBS). Тот же
   инфо-синий и та же полоска слева, что у `tipCard` на вкладках OBS и
   In-game: это один и тот же жест, и третьего вида для него не нужно.

   Не янтарь, хотя объект и называется Warning: ни одно из двух окон ни о чём
   не предупреждает — первое объясняет, для чего кнопка, второе напоминает
   включить запись. Янтарь в программе значит «состояние не в порядке» (бейдж
   warn, причина выключенной кнопки в picker'е), и раздавать его пояснениям
   значит стирать этот сигнал.

   И не акцентный #2F6FB0: это цвет кнопки OK внутри самой карточки. */
QFrame#WarningCard {
    background-color: rgba(56, 189, 248, 0.06);
    border: 1px solid #1E4A63;
    border-left: 3px solid #38BDF8;
    border-radius: 12px;
}
QLabel#WarningTitle {
    color: #38BDF8;
    background: transparent;
    font-size: 16px;
    font-weight: 800;
}

/* Блок поддержки внизу настроек. */
/* Заголовок, а не сигнал: цвет обычной шапки. Золотым он был в старом листе
   и по той же причине снят, что и янтарь выше -- цвет здесь ничего не
   сообщает, а четыре кнопки под ним свои цвета несут сами. */
QLabel#SupportSectionLabel {
    color: #B9C2CE;
    background: transparent;
    font-size: 13px;
    font-weight: 700;
}
/* Без бокового padding: он был нужен центрированному блоку под линейкой, а в
   карточке отступ уже задан её полями — иначе текст стоит с уступом от
   собственного заголовка. */
QLabel#SupportSectionNote {
    color: #8A94A3;
    background: transparent;
    font-size: 12px;
}
QFrame#SupportDivider {
    background-color: #1B222B;
    border: none;
    min-height: 1px;
    max-height: 1px;
}

/* Четыре кнопки — единственное место в программе, где цвет не наш, а чужого
   бренда, и это осознанно: их узнают по цвету раньше, чем прочитают. */
QPushButton#PatreonButton {
    background-color: #22181A; color: #FF6F61;
    border: 1px solid #4B2B2F; border-radius: 8px;
    font-weight: 700; padding: 7px 12px;
}
QPushButton#PatreonButton:hover { background-color: #2B1D20; border-color: #6A393F; }
QPushButton#KofiButton {
    background-color: #181F24; color: #29ABE0;
    border: 1px solid #264555; border-radius: 8px;
    font-weight: 700; padding: 7px 12px;
}
QPushButton#KofiButton:hover { background-color: #1D262D; border-color: #2F5F77; }
QPushButton#GithubButton {
    background-color: #151B23; color: #F0F6FC;
    border: 1px solid #3D444D; border-radius: 8px;
    font-weight: 700; padding: 7px 12px;
}
QPushButton#GithubButton:hover { background-color: #1F2832; border-color: #586069; }
QPushButton#DiscordButton {
    background-color: #1C2142; color: #AEBBFF;
    border: 1px solid #3B4383; border-radius: 8px;
    font-weight: 700; padding: 7px 12px;
}
QPushButton#DiscordButton:hover { background-color: #252B57; border-color: #5865F2; }

/* QMessageBox — восемь окон в программе, и ни одного правила на них до сих
   пор: они собирались из системных умолчаний внутри тёмного окна, поэтому
   текст лип к иконке, а кнопки стояли вплотную к краю. Стилизуется сам
   QMessageBox, а не QDialog: у него собственный внутренний layout. */
QMessageBox {
    background-color: #0B0F14;
}
QMessageBox QLabel {
    background: transparent;
    color: #EDF1F5;
    font-size: 13px;
    /* Отступ слева от иконки и снизу до кнопок: у QMessageBox нет полей, и
       без них текст стоит в упор к обоим. */
    padding: 4px 8px 10px 8px;
}
QMessageBox QPushButton {
    min-width: 84px;
}

/* =============================================== общий каркас модальных окон ==
   `ui/dialogs/shell.py`. До него у четырнадцати окон не совпадало ничего:
   ширины 223…760 без шкалы, у половины не было заголовка внутри окна, кнопки
   у одних лежали вплотную к рамке, у других с отступом. По отдельности это не
   видно — видно на паре открытых подряд окон. */
QLabel#dialogTitle {
    color: #EDF1F5;
    background: transparent;
    font-size: 15px;
    font-weight: 700;
}
QLabel#dialogSubtitle {
    color: #8A94A3;
    background: transparent;
    font-size: 12px;
}
/* Линейка под шапкой — тот же приём, что у карточки настроек: не отдельный
   QFrame с рамкой, а полоса в один пиксель. */
QFrame#dialogHeadRule {
    background-color: #1B222B;
    border: none;
    min-height: 1px;
    max-height: 1px;
}
QWidget#dialogHead, QWidget#dialogFooter { background: transparent; }
/* Одинаковая минимальная ширина: иначе кнопка «OK» вдвое уже «Cancel» рядом,
   и пара читается как разные по весу. */
QWidget#dialogFooter QPushButton { min-width: 96px; }
QLabel#dialogNote { color: #5C6675; background: transparent; font-size: 12px; }
/* То, о чём спрашивает окно, — имя записи в «удалить запись?». Не заголовок и
   не подпись: это данные, и их читают. */
QLabel#dialogSubject {
    color: #EDF1F5;
    background: transparent;
    font-size: 13px;
    font-weight: 600;
}
QLabel#dialogCardText { background: transparent; color: #EDF1F5; font-size: 13px; }
QFrame#InfoCard {
    background-color: #152A40;
    border: 1px solid #285475;
    border-radius: 12px;
}
QFrame#DangerInfoCard {
    background-color: #35191C;
    border: 1px solid #6B2A31;
    border-radius: 12px;
}

/* ======================================================================
   Нижняя полоска окна. До неё у окна не было футера вообще: в корневой
   layout клались шапка и сплиттер, и всё. Поэтому версии и ссылкам негде
   было жить — первая читалась только в заголовке окна, вторые лежали в
   диалоге настроек, куда после первой настройки хоткеев не заходят.
   ====================================================================== */
QFrame#appFooter {
    background-color: #080C11;
    border: none;
    border-top: 1px solid #1B222B;
}
/* Фон темнее корпуса (#0E1217), а не светлее: полоска должна уходить под
   контент, а не всплывать над ним. Одной линии сверху для этого мало —
   у Logs прямо над футером стоит своя строка «6 lines · buffer limit»,
   и без разницы фонов две серые строки читались бы как одна лесенка. */
QFrame#appFooter QLabel { background: transparent; }
/* Только номер: имя приложения стоит в заголовке окна и в шапке, и третья
   копия здесь ничего не добавляла. Вес 600, а не 700 — в паре «BonkScanner
   v2.1.7» жирный отделял номер от имени, а в одиночку ему нечего отделять. */
QLabel#footerVersionNumber { color: #8A94A3; font-size: 11.5px; font-weight: 600; }
/* #2A3542, не #212B36: линия в один пиксель при масштабе 125% ложится на
   полпикселя и половину контраста теряет — на замере тёмный вариант читался
   как отсутствие разделителя вовсе. Это тот же цвет, что у делителя шапки. */
QFrame#footerSeparator {
    background-color: #2A3542;
    border: none;
}
/* Кнопка, а не подпись: «Up to date» мёртвым текстом — самое бесполезное,
   что тут может стоять, это факт на момент запуска без способа переспросить.
   Перепроверка жила только за кнопкой в диалоге настроек, то есть в двух
   кликах и одном модальном окне от строки, которая ответ и показывает. */
QPushButton#footerUpdate {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 2px 1px;
    font-size: 11.5px;
    font-weight: 500;
    color: #5C6675;
}
QPushButton#footerUpdate:hover {
    color: #B9C2CE;
    border-bottom: 1px solid #2E3A48;
    padding-bottom: 1px;
}
/* Единственное состояние, которое повышает голос, и единственное, где это
   заслуженно: появилось то, чего у пользователя нет. */
QPushButton#footerUpdate[state="available"] { color: #7DE68C; font-weight: 700; }
QPushButton#footerUpdate[state="available"]:hover { color: #A7F3B4; border-bottom-color: #1F4A2E; }
/* Пока запрос в полёте — не нажимается и не подсвечивается. */
QPushButton#footerUpdate:disabled { color: #3F4A59; }

/* Три ссылки остаются без фона, но больше не выглядят выключенными. Цвета
   задаются qproperty, потому что сама кнопка плавно смешивает normal/hover и
   рисует короткую линию из центра — QSS умеет только мгновенный border-bottom. */
QPushButton#footerLink, QPushButton#footerSupportLink {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 2px 1px;
    font-size: 11.5px;
    /* 500, а не 600: Qt рисует Segoe UI Semibold заметно жирнее, чем браузер
       в макете, и правый край начинал перевешивать строку с версией. */
    font-weight: 500;
}
QPushButton#footerLink[linkRole="github"] {
    color: #B9C2CE;
    qproperty-restColor: #B9C2CE;
    qproperty-hoverColor: #EDF1F5;
    qproperty-lineColor: #EDF1F5;
}
QPushButton#footerLink[linkRole="discord"] {
    color: #AEBBFF;
    qproperty-restColor: #AEBBFF;
    qproperty-hoverColor: #CDD3FF;
    qproperty-lineColor: #CDD3FF;
}
/* Сердце рисуется отдельно и чуть крупнее подписи. Python анимирует только его;
   цвет по-прежнему тот же Patreon red, что у кнопки в настройках. */
QPushButton#footerSupportLink {
    color: #FF6F61;
    qproperty-restColor: #FF6F61;
    qproperty-hoverColor: #FF978C;
    qproperty-lineColor: #FF978C;
}

/* Всплывашка выбора площадки. Площадок две, и выбирать за пользователя
   незачем; голая ссылка контекста не несёт. */
QFrame#supportPopup { background: transparent; }
QFrame#supportPopupCard {
    background-color: #101419;
    border: 1px solid #2A3542;
    border-radius: 11px;
}
QFrame#supportPopupCard QLabel { background: transparent; }
QLabel#supportPopupTitle { color: #B9C2CE; font-size: 12.5px; font-weight: 800; }
QLabel#supportPopupNote { color: #8A94A3; font-size: 12px; font-weight: 600; }
QWidget#supporterLegend { background: transparent; }
QWidget#supporterLegend QLabel {
    color: #8A94A3;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
}
/* Match the platform colours used by supporter names. The parent-qualified
   selectors deliberately outrank the muted legend default above. */
QWidget#supporterLegend QLabel#supporterLegendPatreon { color: #FF6F61; }
QWidget#supporterLegend QLabel#supporterLegendKofi { color: #29ABE0; }
QFrame#supporterLegendSeparator {
    background-color: #2A3542;
    border: none;
}
/* Список саппортеров. Имена приходят из supporters.json в репозитории —
   `app.supporters.load_supporters`. Пустой случай и есть отгружаемый: без
   списка карточка выглядит ровно как раньше. */
QWidget#supporterList { background: transparent; }
QLabel#supporterName { color: #B9C2CE; font-size: 11.5px; background: transparent; }
/* Три состояния, различаются платформой, а не суммой. Патреон и пак — один и
   тот же красный, потому что деньги одинаковые; ромбик остаётся только у
   подписки, потому что она продолжается. Ko-fi — свой синий, тот же, что у
   кнопки Ko-fi выше: это «другое место», а не «другой уровень». Четвёртого
   состояния быть не должно — карточка благодарности, а не прайс-лист. */
QLabel#supporterNamePatreon { color: #FF6F61; font-size: 11.5px; font-weight: 700; background: transparent; }
QLabel#supporterNamePack { color: #FF6F61; font-size: 11.5px; font-weight: 700; background: transparent; }
QLabel#supporterNameKofi { color: #29ABE0; font-size: 11.5px; font-weight: 700; background: transparent; }
QFrame#supportPopupRule { background-color: #1B222B; border: none; }
